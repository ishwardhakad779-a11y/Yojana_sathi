# Groq API Key (100% Free on console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Multiple Groq API Keys for automatic rotation (free tier resilience)
# GROQ_API_KEYS=gsk_key1,gsk_key2

# Optional: Default Groq Model
GROQ_MODEL=openai/gpt-oss-20b

# Optional: PostgreSQL Connection String (Render Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/yojana_db

# Optional: CORS allowed origins (comma-separated, default is *)
ALLOWED_ORIGINS=*
